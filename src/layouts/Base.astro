---
interface Props {
  title?: string;
  description?: string;
}

const { title = "Golden Bucket Movies", description = "Busca películas y descubre su Golden Score basado en TMDB, IMDb y OMDB." } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/Images/adults.png" />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>